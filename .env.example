GCP_PROJECT=your-gcp-project-id
BQ_RAW_DATASET=raw_african_macro
BQ_FX_TABLE=raw_fx_rates
BQ_LOCATION=US
# Host path to the service account JSON; Compose mounts it read-only into Airflow.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Airflow notification recipient and SMTP connection (URL-encode special characters).
ALERT_EMAIL=you@example.com
AIRFLOW_CONN_SMTP_DEFAULT=smtp://username:password@smtp.example.com:587?from_email=airflow%40example.com

# Airflow secrets: generate your own and never commit real values.
#   FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Others:      python -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Optional ExchangeRate-API key; without it the free open.er-api.com endpoint is used.
FX_RATES_KEY=
